{
  "format": "semantic_inputs/2",
  "_note": "预设(语义)输入目录: 每个条目 = 一个可**单独添加**的语义输入项(name -> 依赖的引擎资源 + MaterialInput 字段 + 构造实现)。group 仅用于界面分组显示(不是可添加的一整类)。人工维护(非从 mmtr 抽取)。",
  "entries": [
    {
      "name": "uv0",
      "group": "UV",
      "desc": "第一套 UV(插值 v1.w/v2.x)",
      "depends": ["INTERPOLATOR0", "INTERPOLATOR1"],
      "field": {"name": "uv0", "type": "float2"},
      "impl": ["mi.uv0 = float2(i.v1.w, i.v2.x);"]
    },
    {
      "name": "uv1",
      "group": "UV",
      "desc": "第二套 UV(插值 v2.yz)",
      "depends": ["INTERPOLATOR1"],
      "field": {"name": "uv1", "type": "float2"},
      "impl": ["mi.uv1 = i.v2.yz;"]
    },
    {
      "name": "NormalWS",
      "group": "几何",
      "desc": "世界(光照)空间法线; 做 N·L 用它(与光方向同空间)",
      "depends": ["INTERPOLATOR0"],
      "field": {"name": "NormalWS", "type": "float3"},
      "impl": ["mi.NormalWS = normalize(i.v1.xyz);"]
    },
    {
      "name": "TangentWS",
      "group": "几何",
      "desc": "世界空间切线(插值切线经 .xzy 归一到世界空间)",
      "depends": ["INTERPOLATOR1", "INTERPOLATOR2"],
      "field": {"name": "TangentWS", "type": "float3"},
      "impl": [
        "float3 _tWS = normalize(float3(i.v2.w, i.v3.y, i.v3.x));",
        "mi.TangentWS = _tWS.xzy;"
      ]
    },
    {
      "name": "BitangentWS",
      "group": "几何",
      "desc": "世界空间副切线(由 GBuffer 基 N×T 与 bitangent 符号得, 经 .xzy 归一)",
      "depends": ["INTERPOLATOR0", "INTERPOLATOR1", "INTERPOLATOR2"],
      "field": {"name": "BitangentWS", "type": "float3"},
      "impl": [
        "float3 _ngB = normalize(i.v1.xyz).xzy;",
        "float3 _tgB = normalize(float3(i.v2.w, i.v3.y, i.v3.x));",
        "float3 _bgB = cross(_ngB, _tgB);",
        "_bgB = (i.v3.z < 0.0) ? -_bgB : _bgB;",
        "mi.BitangentWS = normalize(_bgB).xzy;"
      ]
    },
    {
      "name": "Normal",
      "group": "几何",
      "desc": "GBuffer/插值约定的世界法线基 N(已 .xzy; 供直写 RT2 打包; 光照请用 NormalWS)",
      "depends": ["INTERPOLATOR0"],
      "field": {"name": "Normal", "type": "float3"},
      "impl": ["mi.Normal = normalize(i.v1.xyz).xzy;"]
    },
    {
      "name": "Tangent",
      "group": "几何",
      "desc": "GBuffer/插值约定的切线基 T(供直写 RT2 打包)",
      "depends": ["INTERPOLATOR1", "INTERPOLATOR2"],
      "field": {"name": "Tangent", "type": "float3"},
      "impl": ["mi.Tangent = normalize(float3(i.v2.w, i.v3.y, i.v3.x));"]
    },
    {
      "name": "Bitangent",
      "group": "几何",
      "desc": "GBuffer/插值约定的副切线基 B(由 N×T 与符号得; 供直写 RT2 打包)",
      "depends": ["INTERPOLATOR0", "INTERPOLATOR1", "INTERPOLATOR2"],
      "field": {"name": "Bitangent", "type": "float3"},
      "impl": [
        "float3 _nB = normalize(i.v1.xyz).xzy;",
        "float3 _tB = normalize(float3(i.v2.w, i.v3.y, i.v3.x));",
        "float3 _bB = cross(_nB, _tB);",
        "_bB = (i.v3.z < 0.0) ? -_bB : _bB;",
        "mi.Bitangent = normalize(_bB);"
      ]
    },
    {
      "name": "positionWS",
      "group": "几何",
      "desc": "世界坐标(插值 v3.w/v4.xy)",
      "depends": ["INTERPOLATOR2", "INTERPOLATOR3"],
      "field": {"name": "positionWS", "type": "float3"},
      "impl": ["mi.positionWS = float3(i.v3.w, i.v4.x, i.v4.y);"]
    },
    {
      "name": "camPos",
      "group": "相机",
      "desc": "相机世界位置(依赖 SceneInfo.transposeViewInvMat)",
      "depends": ["SceneInfo"],
      "field": {"name": "camPos", "type": "float3"},
      "impl": ["mi.camPos = float3(transposeViewInvMat[0].w, transposeViewInvMat[1].w, transposeViewInvMat[2].w);"]
    },
    {
      "name": "camDir",
      "group": "相机",
      "desc": "相机前方向(依赖 SceneInfo.transposeViewInvMat)",
      "depends": ["SceneInfo"],
      "field": {"name": "camDir", "type": "float3"},
      "impl": ["mi.camDir = normalize(float3(transposeViewInvMat[0].z, transposeViewInvMat[1].z, transposeViewInvMat[2].z));"]
    },
    {
      "name": "camUp",
      "group": "相机",
      "desc": "相机上方向(依赖 SceneInfo.transposeViewInvMat)",
      "depends": ["SceneInfo"],
      "field": {"name": "camUp", "type": "float3"},
      "impl": ["mi.camUp = normalize(float3(transposeViewInvMat[0].y, transposeViewInvMat[1].y, transposeViewInvMat[2].y));"]
    },
    {
      "name": "velocity",
      "group": "系统",
      "desc": "屏幕空间运动矢量(上一帧裁剪坐标 W 齐次除法 - NDC; 供直写 RT3.zw)",
      "depends": ["SceneInfo", "INTERPOLATOR3", "INTERPOLATOR4"],
      "field": {"name": "velocity", "type": "float2"},
      "impl": [
        "float2 _ndc = i.svpos.xy * screenInverseSize * float2(2.0, -2.0) + float2(-1.0, 1.0);",
        "mi.velocity = (i.v4.zw / i.v5.x) - _ndc;"
      ]
    },
    {
      "name": "exposureScale",
      "group": "系统",
      "desc": "曝光抵消系数 = 1/(白点*曝光系数)(引擎会对 RT0 再乘 <白点*曝光>)",
      "depends": ["WhitePtSrv", "Tonemap"],
      "field": {"name": "exposureScale", "type": "float"},
      "impl": [
        "float _wp = asfloat(WhitePtSrv.Load(0));",
        "_wp = (useAutoExposure != 0) ? _wp : 1.0;",
        "_wp = _wp * exposureAdjustment;",
        "mi.exposureScale = 1.0 / max(_wp, 0.0001);"
      ]
    },
    {
      "name": "gbufferTypeFlag",
      "group": "系统",
      "desc": "GBuffer 类型标志(写 RT2.w 用; 依赖 GBufferType)",
      "depends": ["GBufferType"],
      "field": {"name": "gbufferTypeFlag", "type": "float"},
      "impl": ["mi.gbufferTypeFlag = gbufferTypeFlag;"]
    }
  ]
}
